# Copy to .env.local. Leave Supabase blank to run on the seeded in-memory store.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. Leave blank and AI features use scripted fallbacks.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# Demo mode: quick-login cards, time-skip, demo accounts. Off by default.
# Local demo: set NEXT_PUBLIC_DEMO_MODE=true. NEXT_PUBLIC_* is baked in at BUILD time,
# so changing it on Vercel needs a redeploy.
# In production the server also requires DEMO_MODE=true (read at runtime), so a public
# deploy can switch demo features off by unsetting DEMO_MODE without a rebuild.
NEXT_PUBLIC_DEMO_MODE=
DEMO_MODE=

# Demo-only session signing. REQUIRED in production (NODE_ENV=production, incl. Vercel and `next start`):
# at least 32 characters, e.g. `openssl rand -base64 32`. Dev/test use a public fallback.
DEMO_SESSION_SECRET=
# Optional. Leave blank to use the content default password.
DEMO_PASSWORD=
